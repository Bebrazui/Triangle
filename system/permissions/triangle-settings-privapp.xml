<?xml version="1.0" encoding="utf-8"?>
<!--
  Дополнительный allowlist привилегированных разрешений для TriangleSettings.

  Здесь имеет смысл перечислять только разрешения с protectionLevel, который
  содержит флаг privileged: их выдаёт PackageManager по этому файлу.

  Разрешения без флага privileged добавить нельзя:
    - MANAGE_APP_OPS_MODES  — signature|installer|verifier|role,
    - MANAGE_NOTIFICATIONS  — signature,
    - NFC_PRIVILEGED        — в этой сборке не объявлено;
  они принадлежат ключу, которым подписана GSI (Ponces), а не нашему.
  Штатный /system_ext/etc/permissions/com.android.settings.xml уже покрывает
  BATTERY_STATS, TETHER_PRIVILEGED, READ_PRIVILEGED_PHONE_STATE,
  WRITE_APN_SETTINGS, MANAGE_USERS, STATUS_BAR и остальное.
-->
<permissions>
    <privapp-permissions package="com.android.settings">
        <permission name="android.permission.MODIFY_QUIET_MODE" />
    </privapp-permissions>
</permissions>
