<?xml version="1.0" encoding="utf-8"?>
<!--
  Конфигурация службы переназначения клавиш.

  flagRequestFilterKeyEvents + canRequestFilterKeyEvents включают перехват
  аппаратных клавиш до их доставки приложению. Никаких других возможностей
  (чтение содержимого окон, жесты) службе не нужно — минимум привилегий.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/key_remap_service_description"
    android:notificationTimeout="100" />
